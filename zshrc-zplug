# Load fzf
if [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh

  # fshow - git commit browser
  fshow() {
    git log --graph --color=always \
      --format="%C(auto)%h%d %s %C(green)%cr%C(reset)" "$@" |
    fzf --ansi --no-sort --reverse --tiebreak=index --bind=ctrl-s:toggle-sort \
      --bind "ctrl-m:execute:
        (grep -o '[a-f0-9]\{7\}' | head -1 |
        xargs -I % sh -c 'git show --color=always % | less -R') << 'FZF-EOF'
        {}
FZF-EOF"
  }
export FZF_DEFAULT_COMMAND='ag -l -g ""' # Use ag as the default source for fzf
export FZF_DEFAULT_OPTS='--multi'
fi

# Aliases
if [ -f ~/.alias.zsh ]; then
  source ~/.alias.zsh
fi
# Composer aliases
if [ -f ~/.composer.bash ]; then
  source ~/.composer.bash
fi
# Docker aliases
if [ -f ~/.docker.bash ]; then
  source ~/.docker.bash
fi
if [ -f ~/.docker.zsh ]; then
  source ~/.docker.zsh
fi
# Git aliases
if [ -f ~/.git.bash ]; then
  source ~/.git.bash
fi
if [ -f ~/.git.zsh ]; then
  source ~/.git.zsh
fi
# Make "blinking" font to actually work
export GROFF_NO_SGR=1

set umask 002

